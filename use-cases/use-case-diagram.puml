@startuml

actor "HR Advisor" as HR
actor "Department Manager" as DM

rectangle Database

rectangle "HR System" {
    usecase UC1 as "Get all salaries"
    usecase UC2 as "Get salaries by department"
    usecase UC3 as "Get my department salaries"
    usecase UC4 as "Get salaries by role"
    usecase UC5 as "Add employee"
    usecase UC6 as "View employee"
    usecase UC7 as "Update employee"
    usecase UC8 as "Delete employee"

    usecase UCa as "Print salaries"

    HR --> UC1
    HR --> UC2
    HR --> UC4
    HR --> UC5
    HR --> UC6
    HR --> UC7
    HR --> UC8

    DM --> UC3

    UC1 ..> UCa : include
    UC2 ..> UCa : include
    UC3 ..> UCa : include
    UC4 ..> UCa : include

    UC1 -- Database
    UC2 -- Database
    UC3 -- Database
    UC4 -- Database
    UC5 -- Database
    UC6 -- Database
    UC7 -- Database
    UC8 -- Database
}

@enduml